# MongoDB Atlas connection string
# Get this from Atlas Dashboard -> Database -> Connect -> Drivers
# Replace <username>, <password>, and <cluster-url> with your own values.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/lumix-digital?retryWrites=true&w=majority

PORT=5000

# Comma separated list of allowed origins, e.g. https://lumixdigital.in,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
